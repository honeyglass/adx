{
  "name": "@honeyglass/adx",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "A TypeScript toolkit for command-line tools that AI agents drive, with the Agent DX rules built in. Designed, not built yet.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "default": "./dist/test/index.js"
    },
    "./tsconfig.json": "./tsconfig.base.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p src",
    "typecheck": "tsc -p src --noEmit && tsc -p proto --noEmit && tsc -p tests",
    "test": "ls tests/api/*.api.spec.ts >/dev/null && node --test 'tests/api/*.api.spec.ts' && ls tests/e2e/*.e2e.spec.ts >/dev/null && node --test --test-concurrency=1 'tests/e2e/*.e2e.spec.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@honeyglass/utils": "github:honeyglass/utils#a6c8b941393ba0831b2909a54dae0a59d40f50bf",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@honeyglass/utils": "github:honeyglass/utils#a6c8b941393ba0831b2909a54dae0a59d40f50bf",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "zod": "4.6.5",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10"
  },
  "packageManager": "pnpm@12.9.0+sha512.8f64efa0b792986ca98ae568791bcd7722807e274c4f0c1d9853c62116495c584119db98762a2a5343b1684d361b9ae26fdd16d551666d7635346d3fae830ddd",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
